        <mxCell id="c52" value="Пакетный обмен раз в сутки" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="1106" width="250" height="22" as="geometry" />
