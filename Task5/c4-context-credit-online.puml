@startuml c4-context-credit-online
!include <C4/C4_Context>

title Заявка на кредит онлайн: диаграмма контекста (C4, уровень 1)

AddElementTag("changed", $bgColor="#1F5AC8", $fontColor="#FFFFFF", $borderColor="#123B86", $legendText="Система, которая меняется")
AddElementTag("new", $bgColor="#1E8449", $fontColor="#FFFFFF", $borderColor="#14572F", $legendText="Новая система")
AddElementTag("same", $bgColor="#8A8A8A", $fontColor="#FFFFFF", $borderColor="#5E5E5E", $legendText="Без изменений")
AddElementTag("ext", $bgColor="#6B4E9B", $fontColor="#FFFFFF", $borderColor="#4A3570", $legendText="Внешняя система")

Person(newClient, "Новый клиент", "")
Person(client, "Клиент банка", "Пользователь интернет-банка")
Person(branch, "Менеджер отделения", "Фронт-офис")
Person(crManager, "Менеджер кредитов", "Бэк-офис")

System(site, "Сайт", "Предложение кредита и форма заявки", $tags="changed")
System(ib, "Интернет-банк", "Кредиты, предодобренные предложения, заявки, СМС", $tags="changed")
System(offer, "Сервис предодобрения", "Хранит предложения на основе уже выполненных скорингов", $tags="new")
System(conveyor, "Кредитный конвейер", "Онлайн-заявки, условия, статусы", $tags="changed")
System(scoring, "Система кредитного скоринга", "Режимы: только БКИ и упрощённый", $tags="changed")
System(abs, "АБС", "Заявки клиентов в отделении, зачисление средств. Новый сервис интеграции кредитов", $tags="changed")
System(gw, "СМС-шлюз", "", $tags="same")
System_Ext(bki, "Бюро кредитных историй", "REST API", $tags="ext")

Lay_R(newClient, client)
Lay_R(site, ib)
Lay_R(branch, crManager)
Lay_R(ib, offer)

Rel_D(newClient, site, "UC1–UC3: условия, заявка, решение", "HTTPS")
Rel_D(client, ib, "UC5–UC7: условия, предложение, заявка", "HTTPS")
Rel_R(site, ib, "UC1–UC3: условия, заявка, статус", "REST, HTTPS")
Rel_D(ib, conveyor, "UC1–UC8: заявки, условия, статусы", "Kafka")
Rel_L(offer, ib, "UC6: предложения", "REST")
Rel_U(conveyor, offer, "UC6, UC8: результаты скоринга", "Kafka")
Rel_D(conveyor, scoring, "UC3, UC7: запрос скоринга", "REST")
Rel_R(scoring, bki, "UC3, UC7: кредитная история", "REST")
Rel_D(ib, gw, "UC2, UC3, UC7, UC9: коды, приглашения, статусы", "Протокол шлюза")
Rel_D(crManager, conveyor, "UC8: обрабатывает заявки")
Rel_D(branch, abs, "UC4: продолжает заявку")
Rel(abs, conveyor, "UC4: продолжение заявки", "Kafka")
Rel(conveyor, abs, "UC4: копия заявки. UC10: решение раз в сутки", "Kafka, текущий обмен")

SHOW_LEGEND()
@enduml
